{
  "name": "@smileid/example-js",
  "version": "0.1.0",
  "private": true,
  "description": "Example CLI and integration testbench for the Smile ID JavaScript SDK.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "scripts": {
    "build:sdk": "npm --prefix .. run build",
    "build": "tsc",
    "test": "npm run build:sdk && npm run build && node --test $(find dist -name '*.test.js')",
    "lint": "eslint ."
  },
  "dependencies": {
    "@smileid/usesmileid-nodejs": "file:.."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.39.2",
    "globals": "^16.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
