{
  "name": "@smileid/usesmileid-nodejs",
  "version": "13.0.0",
  "description": "Official Smile ID server-side SDK for JavaScript/TypeScript — V3 APIs.",
  "private": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "lint": "eslint .",
    "test": "npm run build && node --test $(find dist -name '*.test.js')",
    "coverage": "npm run build -- --sourceMap && c8 node --test $(find dist -name '*.test.js')",
    "coverage:generated": "c8 check-coverage --include 'src/generated/**' --include 'dist/generated/**' --per-file --lines 100 --branches 100 --functions 100 --statements 100"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smileidentity/smileid-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/smileidentity/smileid-sdk-js/issues"
  },
  "homepage": "https://github.com/smileidentity/smileid-sdk-js#readme",
  "keywords": [
    "smile",
    "identity",
    "kyc",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/testing"
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^22.10.0",
    "c8": "^11.0.0",
    "eslint": "^9.39.2",
    "globals": "^16.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
